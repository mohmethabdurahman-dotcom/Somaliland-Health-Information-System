@using KMU.HisOrder.MVC.Models
@model IEnumerable<KMU.HisOrder.MVC.Models.KmuChart>
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
@if (TempData["error"] != null)
{
    <h3>@TempData["error"]</h3>
}
<div class="container m-3">
    <form method="post" id="searchForm" asp-action="SearchList" asp-controller="Reception" class="form-group row border-bottom">
        <div class="col-lg-12">
            <div class="form-group row mx-0 mb-0">
                <label class="form-control form-control-lg col-lg-2 font-weight-bold border-0 px-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;Patient ID Number:</label>
                <label class="form-control form-control-lg col-lg-2 font-weight-bold border-0 px-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;Mobile Phone:</label>
                <label class="form-control form-control-lg col-lg-4 font-weight-bold border-0 px-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;&nbsp;Patient Name:</label>
            </div>
            <div class="form-group row mx-0 mb-0">
                <input name="id" type="text" id="id" class="form-control form-control-lg col-lg-2 font-weight-bold text-center rounded" /> &nbsp;
                <input name="phone" type="text" id="phone" class="form-control form-control-lg col-lg-2 font-weight-bold text-center rounded" />&nbsp;
                <input name="name" type="text" id="name" class="form-control form-control-lg col-lg-2 font-weight-bold text-center rounded" />&nbsp;
                <button type="submit" class="btn btn-lg btn-primary float-right px-5">Search</button>
                <button type="button" id="TransferId" class="btn btn-lg btn-info float-right ml-1 px-5">Reserved</button>
            </div>
        </div>
    </form>

    <div id="searchResults">
        <!-- Search results will be loaded here dynamically -->
    </div>
    

</div>
<!-- Modal -->
<div class="modal fade" id="reserveModel">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Bed Assignment</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

            </div>
            <!-- Modal Footer -->
            
              <div class="modal-footer">
              <button type="button"
                         class="btn btn-secondary"
                         data-dismiss="modal">
                     Close
                </button>
                <button type="submit" id="reserveBtn" class="btn btn-primary">
                     <i class="fas fa-calendar-check"></i> Save
                 </button>
             </div>
            
        </div>
    </div>
</div>

@section Scripts{
<script>

    $(document).ready(function () {
        $("#searchForm").submit(function (event) {
            event.preventDefault(); // Prevent full page refresh

            var name = $("#name").val().trim();
            var id = $("#id").val().trim();
            var phone = $("#phone").val().trim();

            if (!name && !id && !phone) {
                 layer.alert("Please enter at least one search criteria!.", {
                            skin: 'layui-layer-lan',
                            closebtn: 1,
                            anim: 5,
                            icon: 2,
                            btn: ['OK'],
                            title: 'Error Message'
                        }, function (index) {
                            layer.close(index);
                        });
                return;
            }

            $.ajax({
                url: "/InPatient/Reception/SearchList",
                type: "POST",
                data: { name: name, id: id, phone: phone },
                success: function (response) {
                    $("#searchForm")[0].reset();
                    $("#searchResults").html(response); // Load only the search results
                },
                error: function () {
                     layer.alert("Error occurred while searching!.", {
                            skin: 'layui-layer-lan',
                            closebtn: 1,
                            anim: 5,
                            icon: 2,
                            btn: ['OK'],
                            title: 'Error Message'
                        }, function (index) {
                            layer.close(index);
                        });
                }
            });
        });
    });

    $("#TransferId").on("click", function (event) {
    $.ajax({
        url: "/InPatient/Reception/TransferList",
        type: "GET",
        success: function (response) {
            $("#searchForm")[0].reset();
            $("#searchResults").html(response); // Load only the search results
        },
        error: function () {
            alert("");
                layer.alert("AError occurred while searching!.", {
                    skin: 'layui-layer-lan',
                    closebtn: 1,
                    anim: 5,
                    icon: 2,
                    btn: ['OK'],
                    title: 'Error Message'
                }, function (index) {
                    layer.close(index);
                });
        }
    });
});



    function ShowModalReserve(url, title) {
            $.ajax({
                url: url,
                type: "GET",
                success: function (data) {
                    $("#reserveModel .modal-title").text(title);
                    $("#reserveModel .modal-body").html(data);
                    $("#reserveModel").modal("show");

                    
                },
                error: function () {
                     layer.alert("Failed to load form.", {
                            skin: 'layui-layer-lan',
                            closebtn: 1,
                            anim: 5,
                            icon: 2,
                            btn: ['OK'],
                            title: 'Error Message'
                        }, function (index) {
                            layer.close(index);
                        });
                    alert("");
                }
            });
        }
</script>
}