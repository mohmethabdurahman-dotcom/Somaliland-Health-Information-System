<!-- Modal (Ward) -->
<div class="modal fade" id="wardModal" tabindex="-1" aria-labelledby="wardTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wardTitle">Select a Pediatric Sub-Ward</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Sub-Ward: Neonatal Care -->
                    <div class="col-md-4">
                        <div class="card p-3" onclick="selectCard(this)">
                            <i class="fas fa-baby icon text-success"></i>
                            <div class="card-body p-2">
                                <h5 class="card-title">Neonatal Care</h5>
                            </div>
                        </div>
                    </div>
                    <!-- Sub-Ward: General Pediatrics -->
                    <div class="col-md-4">
                        <div class="card p-3" onclick="selectCard(this)">
                            <i class="fas fa-stethoscope icon text-danger"></i>
                            <div class="card-body p-2">
                                <h5 class="card-title">General Pediatrics</h5>
                            </div>
                        </div>
                    </div>
                    <!-- Sub-Ward: Pediatric ICU -->
                    <div class="col-md-4">
                        <div class="card p-3" onclick="selectCard(this)">
                            <i class="fas fa-heartbeat icon text-info"></i>
                            <div class="card-body p-2">
                                <h5 class="card-title">Pediatric ICU</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Confirm Selection</button>
            </div>
        </div>
    </div>
</div>


<script>
       const params = new URLSearchParams(window.location.search);
       console.log(params)
       const ward = params.get("url");// Get value of 'ward'
       console.log(ward)


    document.getElementById("pageTitle").textContent = `Welcome to ${ward} ward`;

     function selectCard(card) {
        document.querySelectorAll(".card").forEach(c => c.classList.remove('selected'));

        card.classList.add('selected');
    }

</script>
