<!-- Style -->
<link href="~/css/style.css" rel="stylesheet" />
<style>
    input[type="checkbox"] {
        transform: scale(1.5);
    }

    form-check-inline {
        display: -ms-inline-flexbox;
        display: inline-flex;
        -ms-flex-align: center;
        align-items: center;
        padding-left: 0;
        margin-right: 0.75rem;
        padding-top: 10px;
    }

    .form-check-inline .form-check-input {
        position: static;
        margin-top: 10;
        margin-right: 0.65rem;
        margin-left: 0;
    }

    table.dataTable {
        margin-top: -1em !important;
        /**/
    }

    .card {
        cursor: pointer;
        transition: 0.3s;
        text-align: center;
    }

    .selected {
        border: 2px solid #007bff;
        background-color: rgba(0, 123, 255, 0.1);
    }

    .icon {
        font-size: 40px;
    }
</style>

