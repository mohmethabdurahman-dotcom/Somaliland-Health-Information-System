<style>
/* Blood bank screening certificate — color preview + Epson TM-T20 (80mm thermal) */
.bb-print-body {
  margin: 0;
  padding: 0;
  background: linear-gradient(180deg, #e0f2fe 0%, #e8ecf1 40%, #f1f5f9 100%);
  font-family: "Segoe UI", Inter, Arial, sans-serif;
  color: #0f172a;
}

.bb-print-sheet {
  box-sizing: border-box;
  width: 80mm;
  max-width: 80mm;
  margin: 12px auto 24px;
  padding: 0;
  font-size: 10pt;
  line-height: 1.35;
  color: #0f172a;
}

.bb-print-ticket {
  background: #fff;
  padding: 0 0 4mm;
  border-radius: 6px;
  overflow: hidden;
  box-shadow: 0 8px 28px rgba(2, 132, 199, 0.18);
  border: 1px solid #bae6fd;
}

/* ── Header ── */
.bb-print-head {
  text-align: center;
  padding: 0 3.5mm 3mm;
  margin-bottom: 3mm;
  background: linear-gradient(135deg, #0284C7 0%, #0EA5E9 55%, #38BDF8 100%);
  color: #fff;
}

.bb-print-head__banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2mm;
  font-size: 7.5pt;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 2.5mm 2mm;
  background: rgba(255, 255, 255, 0.15);
  margin: 0 -3.5mm 2.5mm;
  border-bottom: 1px solid rgba(255, 255, 255, 0.25);
}

.bb-print-head__banner-icon {
  font-size: 9pt;
}

.bb-print-head__mohd {
  display: block;
  margin: 0 auto 2mm;
  max-width: 68mm;
  max-height: 14mm;
  width: auto;
  height: auto;
  object-fit: contain;
  background: #fff;
  padding: 1mm 2mm;
  border-radius: 3px;
}

.bb-print-head__row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3mm;
  flex-wrap: nowrap;
  margin-bottom: 2mm;
  background: rgba(255, 255, 255, 0.92);
  padding: 2mm;
  border-radius: 4px;
}

.bb-print-head__his,
.bb-print-head__hosp {
  object-fit: contain;
  height: 11mm;
  width: auto;
  max-width: 32mm;
}

.bb-print-head__divider {
  width: 1px;
  height: 10mm;
  background: #cbd5e1;
  flex-shrink: 0;
}

.bb-print-head__title {
  margin: 2mm 0 0;
  font-size: 10.5pt;
  font-weight: 800;
  line-height: 1.2;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: #fff;
}

.bb-print-head__meta {
  margin-top: 2mm;
  font-size: 8pt;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.95);
}

.bb-print-cert-id {
  display: inline-block;
  font-family: Consolas, "Courier New", monospace;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.22);
  padding: 0.5mm 2mm;
  border-radius: 3px;
  border: 1px solid rgba(255, 255, 255, 0.4);
}

.bb-print-rule {
  border: none;
  border-top: 1px dashed #94a3b8;
  margin: 2.5mm 3.5mm;
}

/* ── Verdict ── */
.bb-print-verdict {
  text-align: center;
  padding: 3mm 2mm;
  margin: 0 3.5mm 3mm;
  border-radius: 6px;
  color: #fff;
}

.bb-print-verdict.is-pass {
  background: linear-gradient(135deg, #059669 0%, #10B981 55%, #34D399 100%);
  box-shadow: 0 2px 8px rgba(5, 150, 105, 0.35);
}

.bb-print-verdict.is-fail {
  background: linear-gradient(135deg, #B91C1C 0%, #EF4444 55%, #F87171 100%);
  box-shadow: 0 2px 8px rgba(220, 38, 38, 0.35);
}

.bb-print-verdict__label {
  display: block;
  font-size: 7pt;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1mm;
  opacity: 0.92;
}

.bb-print-verdict__title {
  display: block;
  font-size: 15pt;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin: 0;
}

.bb-print-verdict__sub {
  display: block;
  font-size: 7.5pt;
  margin-top: 1.5mm;
  line-height: 1.3;
  opacity: 0.95;
}

/* ── Sections ── */
.bb-print-section-title {
  font-size: 8pt;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 3.5mm 2mm;
  padding: 1.5mm 2mm;
  background: linear-gradient(90deg, #0B1F3A, #1C3A5E);
  color: #fff;
  border-radius: 4px;
}

.bb-print-section-title i {
  margin-right: 1.5mm;
  opacity: 0.9;
}

.bb-print-section-title--bag {
  background: linear-gradient(90deg, #5B21B6, #7C3AED);
}

.bb-print-kv {
  width: calc(100% - 7mm);
  margin: 0 3.5mm 3mm;
  border-collapse: collapse;
  font-size: 9pt;
}

.bb-print-kv th,
.bb-print-kv td {
  padding: 1.5mm 1.5mm;
  vertical-align: top;
  text-align: left;
  border-bottom: 1px solid #e2e8f0;
}

.bb-print-kv th {
  width: 36%;
  font-weight: 700;
  font-size: 7.5pt;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: #64748b;
  background: #f8fafc;
}

.bb-print-kv td {
  font-weight: 600;
  color: #0f172a;
}

.bb-print-blood {
  display: inline-block;
  font-weight: 800;
  color: #B91C1C;
  background: #FEE2E2;
  padding: 0.3mm 2mm;
  border-radius: 3px;
}

.bb-print-type-pill {
  display: inline-block;
  font-size: 7.5pt;
  font-weight: 800;
  text-transform: uppercase;
  padding: 0.5mm 2mm;
  border-radius: 999px;
}

.bb-print-type--volunteer {
  background: #D1FAE5;
  color: #047857;
}

.bb-print-type--directed {
  background: #EDE9FE;
  color: #5B21B6;
}

/* ── Tests ── */
.bb-print-tests {
  width: calc(100% - 7mm);
  margin: 0 3.5mm 3mm;
  border-collapse: collapse;
  font-size: 9pt;
  border-radius: 4px;
  overflow: hidden;
}

.bb-print-tests th,
.bb-print-tests td {
  padding: 2mm 1.5mm;
  text-align: left;
}

.bb-print-tests thead th {
  font-size: 7.5pt;
  text-transform: uppercase;
  background: linear-gradient(135deg, #5B21B6, #7C3AED);
  color: #fff;
  font-weight: 800;
  border: none;
}

.bb-print-tests__result {
  width: 18mm;
  text-align: center;
  font-weight: 900;
  font-size: 8.5pt;
  letter-spacing: 0.05em;
}

.bb-print-test--pass td {
  background: #ECFDF5;
}

.bb-print-test--pass .bb-print-tests__result {
  background: linear-gradient(135deg, #34D399, #059669);
  color: #fff;
}

.bb-print-test--fail td {
  background: #FEF2F2;
}

.bb-print-test--fail .bb-print-tests__result {
  background: linear-gradient(135deg, #F87171, #DC2626);
  color: #fff;
}

/* ── Bag serial ── */
.bb-print-bag-block {
  margin: 0 3.5mm 3mm;
  padding: 2mm;
  background: linear-gradient(180deg, #F5F3FF, #fff);
  border: 1px dashed #A78BFA;
  border-radius: 4px;
}

.bb-print-bag-serial {
  font-size: 12pt;
  font-weight: 900;
  text-align: center;
  margin: 1mm 0 0;
  padding: 2mm;
  background: #fff;
  border: 2px solid #7C3AED;
  border-radius: 4px;
  color: #5B21B6;
}

.bb-print-bag-line {
  display: block;
  height: 8mm;
  border-bottom: 2px solid #7C3AED;
  margin: 2mm 0 1mm;
}

.bb-print-bag-hint {
  font-size: 7pt;
  color: #6D28D9;
  text-align: center;
  margin: 0;
}

.bb-print-notes-block {
  margin: 0 3.5mm 3mm;
}

.bb-print-notes {
  font-size: 8.5pt;
  margin: 0;
  padding: 2mm;
  border: 1px solid #FCD34D;
  background: #FFFBEB;
  border-radius: 4px;
  word-break: break-word;
}

.bb-print-footer {
  margin: 3mm 3.5mm 0;
  padding-top: 2mm;
  border-top: 2px dashed #cbd5e1;
  font-size: 8pt;
}

.bb-print-sign {
  margin-bottom: 3mm;
}

.bb-print-sign__line {
  height: 7mm;
  border-bottom: 1px solid #334155;
  margin-bottom: 1mm;
}

.bb-print-sign strong {
  font-size: 7.5pt;
  text-transform: uppercase;
  color: #475569;
}

.bb-print-disclaimer {
  font-size: 6.5pt;
  line-height: 1.35;
  text-align: center;
  margin: 2mm 0 0;
  color: #64748b;
}

.bb-print-printer-tag {
  text-align: center;
  font-size: 7pt;
  color: #94a3b8;
  margin-top: 2mm;
}

.bb-mono {
  font-family: Consolas, "Courier New", monospace;
}

/* Screen-only toolbar */
.bb-print-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 12px;
  max-width: 80mm;
  margin-left: auto;
  margin-right: auto;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.1);
}

.bb-print-actions .bb-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  border: none;
}

.bb-print-actions .bb-btn-primary {
  background: linear-gradient(135deg, #0284C7, #0EA5E9);
  color: #fff;
}

.bb-print-actions .bb-btn-ghost {
  background: #f8fafc;
  color: #334155;
  border: 1px solid #cbd5e1;
}

.bb-print-hint {
  font-size: 12px;
  color: #475569;
  text-align: center;
  margin: 0;
  line-height: 1.4;
}

/* Epson TM-T20 — 80mm roll */
@@media print {
  @@page {
    size: 80mm auto;
    margin: 2mm 3mm;
  }

  html, body.bb-print-body {
    width: 80mm !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #fff !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .no-print {
    display: none !important;
  }

  .bb-print-sheet {
    width: 80mm !important;
    max-width: 80mm !important;
    margin: 0 !important;
    box-shadow: none !important;
  }

  .bb-print-ticket {
    padding: 0 !important;
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .bb-print-head__mohd,
  .bb-print-head__his,
  .bb-print-head__hosp {
    max-height: 12mm;
    -webkit-filter: grayscale(100%) contrast(1.1);
    filter: grayscale(100%) contrast(1.1);
  }

  .bb-print-head,
  .bb-print-verdict,
  .bb-print-section-title,
  .bb-print-tests thead th,
  .bb-print-test--pass .bb-print-tests__result,
  .bb-print-test--fail .bb-print-tests__result,
  .bb-print-type-pill,
  .bb-print-blood {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .bb-print-head,
  .bb-print-verdict,
  .bb-print-bag-block,
  .bb-print-notes-block {
    break-inside: avoid;
    page-break-inside: avoid;
  }
}
</style>
