  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-top: 0.15rem;
}
.bb-dr-kpi__hint {
  font-size: 0.68rem;
  opacity: 0.8;
  margin-top: 0.05rem;
}
/* Pending — amber / waiting */
.bb-dr-kpi--pending {
  color: #92400E;
  background: linear-gradient(145deg, #FFFBEB 0%, #FDE68A 100%);
  border-color: #F59E0B;
  box-shadow: 0 2px 10px rgba(245, 158, 11, 0.25);
}
