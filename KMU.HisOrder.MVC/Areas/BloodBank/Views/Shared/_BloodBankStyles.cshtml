  align-items: center;
  gap: 0.4rem;
}
.bb-find-donor__loading {
  margin-top: 1rem;
  font-size: 0.9rem;
  color: var(--bb-text-muted);
}
.bb-find-donor__error {
  margin-top: 1rem;
