  box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
}
.bb-vitals-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.bb-deferral-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.bb-deferral-list li { margin-bottom: 0.5rem; font-size: 0.875rem; }
.bb-deferral-list label { display: flex; gap: 0.5rem; align-items: flex-start; cursor: pointer; }
.bb-typeahead-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 4px;
  background: var(--bb-white);
  border: 1px solid var(--bb-border);
  border-radius: 8px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  max-height: 14rem;
  overflow-y: auto;
  z-index: 30;
  display: none;
}
.bb-typeahead-dropdown.is-open { display: block; }
.bb-typeahead-dropdown li {
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
  cursor: pointer;
  border-bottom: 1px solid var(--bb-border);
}
.bb-typeahead-dropdown li:hover { background: var(--bb-surface); }
.bb-typeahead-wrap { position: relative; }
.bb-donation-type-radios {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
}
.bb-donation-type-radios label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.35rem;
  padding: 1rem;
  border: 2px solid var(--bb-border);
  border-radius: 12px;
  cursor: pointer;
  text-align: center;
  font-size: 0.875rem;
  font-weight: 600;
}
.bb-donation-type-radios label:has(input:checked) {
  border-color: var(--bb-navy);
  background: rgba(11, 31, 58, 0.04);
}
.bb-donation-type-radios input { position: absolute; opacity: 0; pointer-events: none; }
.bb-field-wrap { margin-bottom: 1rem; }
.bb-field-wrap:last-child { margin-bottom: 0; }
.bb-bp-inputs { display: flex; gap: 0.5rem; align-items: center; }
.bb-bp-inputs .form-control { flex: 1; }
.bb-directed-panel.hidden { display: none !important; }
.bb-screening-inline {
  padding-top: 1rem;
  border-top: 1px solid var(--bb-border);
}
.bb-screening-attest {
  display: flex;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  align-items: flex-start;
}
.bb-screening-actions { margin-top: 0.75rem; }
.bb-screening-table-wrap {
  margin-bottom: 0.5rem;
  border: 1px solid var(--bb-border);
  border-radius: 8px;
}
.bb-screening-table-wrap .bb-table-scroll { max-height: 200px; overflow-y: auto; }
.bb-screening-vitals-table input.form-control-sm { max-width: 7rem; }
.bb-input-unit { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
.bb-input-unit span { font-size: 0.8rem; color: var(--bb-muted); }
.bb-vital-status { font-size: 0.8rem; font-weight: 600; }
.bb-vital-status.is-ok { color: var(--bb-emerald); }
.bb-vital-status.is-fail { color: var(--bb-red); }
.bb-screening-deferral-table td:first-child { text-align: center; }
.bb-directed-requests {
  margin-top: 1rem;
}
.bb-directed-requests .bb-table-scroll {
  max-height: 220px;
  overflow-y: auto;
  border: 1px solid var(--bb-border);
  border-radius: 8px;
}
#directedRequestsBody tr { cursor: pointer; }
#directedRequestsBody tr:hover { background: var(--bb-surface); }
#directedRequestsBody tr.is-selected { background: rgba(16, 185, 129, 0.12); }
.bb-card__header .bb-lock-badge { margin-left: auto; }
body.bb-modal-open { overflow: hidden; }

/* ── Request details (View) ── */
.nav-md #page_content.right_col:has(.bb-request-detail-page),
.nav-md .container.body #page_content.right_col:has(.bb-request-detail-page),
#page_content.right_col:has(.bb-request-detail-page) {
  padding: 0 !important;
  padding-top: 0 !important;
}
.bb-request-detail-page {
  padding: 0 0 1.5rem;
  margin: 0;
  min-height: 0;
  background: var(--bb-surface);
}
.bb-request-detail-page > .bb-request-detail-stats,
.bb-request-detail-page > .bb-request-detail-workflow,
.bb-request-detail-page > .bb-request-detail-alert,
.bb-request-detail-page > .bb-request-details-grid,
.bb-request-detail-page > .bb-card {
  margin-left: 0.75rem;
  margin-right: 0.75rem;
}
.bb-request-detail-hero {
  position: relative;
  border-radius: 0;
  overflow: visible;
  margin: 0 0 0.85rem;
  background: linear-gradient(135deg, var(--bb-navy) 0%, var(--bb-navy-light) 55%, #1e4a6e 100%);
  color: var(--bb-white);
  box-shadow: 0 4px 18px rgba(11, 31, 58, 0.18);
  width: 100%;
  max-width: 100%;
  clear: both;
}
.bb-request-detail-hero h6.direction {
  color: #fff;
  font-size: 1rem;
  margin: 0;
}
.bb-request-detail-hero h6.direction i { margin-right: 0.4rem; }
.bb-request-detail-hero__accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6px;
  background: var(--bb-sky);
}
.bb-request-detail-hero.routine .bb-request-detail-hero__accent { background: var(--bb-sky); }
.bb-request-detail-hero.urgent .bb-request-detail-hero__accent { background: var(--bb-amber); }
.bb-request-detail-hero.emergency .bb-request-detail-hero__accent {
  background: var(--bb-red);
  animation: bb-pulse-border 2s ease-in-out infinite;
}
.bb-request-detail-hero__inner {
  padding: 0.4rem 1.15rem 0.55rem 1.15rem;
}
.bb-request-detail-breadcrumb {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  opacity: 0.85;
  margin-bottom: 0.2rem;
}
.bb-request-detail-breadcrumb a {
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
}
.bb-request-detail-breadcrumb a:hover { text-decoration: underline; }
.bb-request-detail-breadcrumb span { opacity: 0.6; }
.bb-request-detail-hero__row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.25rem;
}
.bb-request-detail-hero__title {
  margin: 0 0 0.1rem;
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--bb-white);
  letter-spacing: -0.02em;
}
.bb-request-detail-hero__meta {
  font-size: 0.85rem;
  opacity: 0.9;
  margin: 0;
}
.bb-request-detail-page .bb-hero-lead {
  display: none;
}
.bb-request-detail-hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}
.bb-request-detail-hero__id {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  background: rgba(255, 255, 255, 0.12);
  padding: 0.25rem 0.6rem;
  border-radius: 6px;
}
.bb-request-detail-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.bb-request-detail-stat {
  background: var(--bb-white);
  border: 1px solid var(--bb-border);
  border-radius: 12px;
  padding: 1rem 1.15rem;
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
  transition: box-shadow 150ms ease, transform 150ms ease;
}
.bb-request-detail-stat:hover {
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  transform: translateY(-1px);
}
.bb-request-detail-stat__icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.bb-request-detail-stat__icon--blood { background: var(--bb-red-light); color: var(--bb-red); }
.bb-request-detail-stat__icon--units { background: var(--bb-sky-light); color: var(--bb-sky); }
.bb-request-detail-stat__icon--component { background: var(--bb-emerald-light); color: var(--bb-emerald); }
.bb-request-detail-stat__icon--time { background: #ede9fe; color: #6d28d9; }
.bb-request-detail-stat__label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--bb-text-muted);
  font-weight: 600;
  margin: 0 0 0.2rem;
}
.bb-request-detail-stat__value {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--bb-navy);
  margin: 0;
  line-height: 1.3;
}
.bb-request-detail-workflow {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 1.5rem;
  padding: 1rem 1.25rem;
  background: var(--bb-white);
  border: 1px solid var(--bb-border);
  border-radius: 12px;
}
.bb-request-detail-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  min-width: 0;
}
.bb-request-detail-step:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 1.1rem;
  left: 55%;
  width: 90%;
  height: 2px;
  background: var(--bb-border);
  z-index: 0;
}
.bb-request-detail-step.is-done:not(:last-child)::after {
  background: var(--bb-emerald);
}
.bb-request-detail-step__dot {
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  background: var(--bb-surface);
  border: 2px solid var(--bb-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  color: var(--bb-text-muted);
  position: relative;
  z-index: 1;
  margin-bottom: 0.4rem;
}
.bb-request-detail-step.is-done .bb-request-detail-step__dot {
  background: var(--bb-emerald);
  border-color: var(--bb-emerald);
  color: var(--bb-white);
}
.bb-request-detail-step.is-current .bb-request-detail-step__dot {
  background: var(--bb-navy);
  border-color: var(--bb-navy);
  color: var(--bb-white);
  box-shadow: 0 0 0 4px rgba(11, 31, 58, 0.15);
}
.bb-request-detail-step.is-fail .bb-request-detail-step__dot {
  background: var(--bb-red);
  border-color: var(--bb-red);
  color: var(--bb-white);
}
.bb-request-detail-step__label {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--bb-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.bb-request-detail-step__sub {
  font-size: 0.7rem;
  color: var(--bb-text-muted);
  margin-top: 0.15rem;
}
.bb-request-details-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 1.25rem;
  align-items: start;
}
.bb-request-detail-panel .bb-patient-panel { margin-top: 0; }
.bb-request-detail-specs {
  display: grid;
  gap: 0.65rem;
}
.bb-request-detail-spec {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  padding: 0.75rem 0.85rem;
  background: var(--bb-surface);
  border-radius: 10px;
  border: 1px solid transparent;
}
.bb-request-detail-spec:hover {
  border-color: var(--bb-border);
  background: var(--bb-white);
}
.bb-request-detail-spec__icon {
  width: 2rem;
  height: 2rem;
  border-radius: 8px;
  background: var(--bb-white);
  border: 1px solid var(--bb-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bb-navy);
  flex-shrink: 0;
  font-size: 0.85rem;
}
.bb-request-detail-spec__label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--bb-text-muted);
  font-weight: 600;
  margin: 0 0 0.15rem;
}
.bb-request-detail-spec__value {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--bb-text-primary);
  margin: 0;
}
.bb-request-detail-actions {
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--bb-border);
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: flex-start;
}
.bb-request-detail-reject-panel {
  display: none;
  width: 100%;
  margin-top: 0.75rem;
  padding: 1rem;
  background: var(--bb-red-light);
  border: 1px solid #fecaca;
  border-radius: 10px;
}
.bb-request-detail-reject-panel.is-open {
  display: block;
}
.bb-request-detail-reject-panel .form-control { max-width: 100%; }
.bb-request-detail-alert {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 1rem 1.15rem;
  border-radius: 10px;
  margin-bottom: 1.25rem;
}
.bb-request-detail-alert--reject {
  background: var(--bb-red-light);
  border: 1px solid #fecaca;
  color: #991b1b;
}
.bb-request-detail-dispense-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.bb-request-detail-dispense-item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 1rem;
  align-items: center;
  padding: 1rem 1.15rem;
  background: var(--bb-surface);
  border: 1px solid var(--bb-border);
  border-radius: 10px;
  border-left: 4px solid var(--bb-emerald);
}
.bb-request-detail-dispense-item__when {
  text-align: center;
  min-width: 4.5rem;
}
.bb-request-detail-dispense-item__date {
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--bb-navy);
  display: block;
}
.bb-request-detail-dispense-item__time {
  font-size: 0.75rem;
  color: var(--bb-text-muted);
}
.bb-request-detail-dispense-item__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  font-size: 0.85rem;
  color: var(--bb-text-secondary);
}
.bb-request-detail-dispense-item__meta strong { color: var(--bb-text-primary); }
.bb-request-detail-dispense-item__serials {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.82rem;
  background: var(--bb-white);
  padding: 0.35rem 0.65rem;
  border-radius: 6px;
  border: 1px solid var(--bb-border);
  text-align: right;
}
.bb-request-detail-empty {
  text-align: center;
  padding: 2rem 1rem;
  color: var(--bb-text-muted);
}
.bb-request-detail-empty i {
  font-size: 2rem;
  opacity: 0.4;
  margin-bottom: 0.5rem;
  display: block;
}

@@media (max-width: 1279px) {
  .bb-request-detail-stats { grid-template-columns: repeat(2, 1fr); }
  .bb-request-details-grid { grid-template-columns: 1fr; }
  .bb-request-detail-workflow { flex-wrap: wrap; gap: 1rem; }
  .bb-request-detail-step:not(:last-child)::after { display: none; }
  .bb-registration-grid { grid-template-columns: 1fr; }
  .bb-donor-reg-3col { grid-template-columns: 1fr; }
  .bb-vitals-grid { grid-template-columns: 1fr; }
}
@@media (max-width: 767px) {
  .bb-request-detail-stats { grid-template-columns: 1fr; }
  .bb-request-detail-dispense-item { grid-template-columns: 1fr; text-align: left; }
  .bb-request-detail-dispense-item__serials { text-align: left; }
}

/* ── MRFind-style donor search ── */
.bb-mrfind-direction,
.bb-section-direction {
  font-weight: 700;
  font-size: 0.9rem;
  letter-spacing: 0.02em;
  color: var(--bb-navy);
  margin-bottom: 0.75rem;
}
.bb-section-direction i { margin-right: 0.35rem; color: var(--bb-text-muted); }
.bb-page-head-compact {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  margin: 0;
  padding: 0 0 0.5rem;
}
.bb-page-head-compact h6,
.bb-page-head-compact .direction {
  font-weight: 700;
  color: var(--bb-navy);
  margin: 0 !important;
  font-size: 1.05rem;
  line-height: 1.3;
}
.bb-page-head-compact h6 i { margin-right: 0.4rem; color: var(--bb-text-muted); }
.bb-page-head-compact + .bb-alert,
.bb-page-head-compact + .text-danger {
  margin-top: 0.5rem;
}
.bb-mrfind-label {
  font-weight: bold;
  border: 0;
  background: inherit;
  font-size: 12px;
  padding: 0 0 0.25rem;
  margin: 0;
}
.bb-mrfind-bar {
  background: #fff;
  padding: 0.75rem 0 1rem;
  margin-bottom: 1rem;
}
.bb-mrfind-bar--compact { padding: 0.5rem 0; margin-bottom: 1.25rem; border: 1px solid var(--bb-border); border-radius: var(--bb-radius-lg); padding: 1rem; }
.bb-mrfind-results-dash { margin-top: 0.5rem; max-height: 420px; overflow: auto; }
.bb-mrfind-table { margin-bottom: 0; }
.bb-mrfind-row.trHighlight,
.bb-mrfind-table tr.trHighlight {
  background-color: #fffad7 !important;
}
.bb-mrfind-action { color: var(--bb-red); }
.bb-mrfind-action:hover { color: #7f1d1d; }

/* ── Advanced Find Donor (MRFind + Blood Bank) ── */
.bb-find-donor-advanced {
  background: #fff;
  border: 1px solid var(--bb-border);
  border-radius: var(--bb-radius-lg);
  padding: 1.25rem 1.5rem 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  border-top: 4px solid var(--bb-red);
}
.bb-find-donor-advanced__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: flex-start;
}
.bb-mrfind-primary { margin-top: 0.5rem; }
.bb-find-advanced-section { margin-top: 0.25rem; }
.bb-find-advanced-toggle {
  margin-bottom: 0.5rem;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}
.bb-find-advanced-toggle__chevron {
  font-size: 0.7rem;
  transition: transform 0.2s ease;
}
.bb-find-advanced-toggle[aria-expanded="true"] .bb-find-advanced-toggle__chevron {
  transform: rotate(180deg);
}
.bb-find-advanced-toggle[aria-expanded="true"] {
  background: #e0f2fe;
  border-color: #0ea5e9;
  color: #0369a1;
}
.bb-find-advanced-panel {
  margin-top: 0;
  padding: 1rem;
  border: 1px solid var(--bb-border);
  border-radius: 8px;
  background: #f8fafc;
}
.bb-find-advanced-panel.hidden { display: none !important; }
.bb-find-advanced-panel__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px dashed var(--bb-border);
}
.bb-find-advanced-panel__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.bb-find-advanced-check {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--bb-text-primary);
  display: flex;
  align-items: center;
  gap: 0.4rem;
  cursor: pointer;
}
.bb-find-selected-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-top: 1rem;
  padding: 0.85rem 1rem;
  background: linear-gradient(90deg, #fef2f2 0%, #fff 100%);
  border: 1px solid #fecaca;
  border-radius: 10px;
}
.bb-find-selected-strip.hidden { display: none !important; }
.bb-find-selected-strip__info {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.65rem;
}
.bb-find-selected-strip__actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.bb-find-results-section { margin-top: 0.5rem; }
.bb-find-results-wrap { margin-top: 0.75rem; }
.bb-find-results-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.25rem;
  padding: 0.65rem 0;
  margin-bottom: 0.35rem;
  border-bottom: 1px solid var(--bb-border);
}
.bb-find-results-count { font-size: 0.95rem; color: var(--bb-navy); }
.bb-find-results-count i { color: var(--bb-red); margin-right: 0.25rem; }
.bb-find-results-truncated {
  font-size: 0.8rem;
  color: var(--bb-text-muted);
  font-style: italic;
}
.bb-find-results-hint {
  margin-left: auto;
  font-size: 0.75rem;
  color: var(--bb-text-muted);
}
@@media (max-width: 991px) {
  .bb-find-results-hint { margin-left: 0; width: 100%; }
  .bb-find-donor-advanced__actions { width: 100%; margin-top: 0.75rem; }
}

/* ── Find donor (HIS-style) ── */
.bb-find-donor {
  background: #fff;
  border: 2px solid var(--bb-red);
