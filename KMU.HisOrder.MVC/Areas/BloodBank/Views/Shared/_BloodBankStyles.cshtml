/* ── Audit ── */
.bb-audit-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

/* ── Toast ── */
.bb-toast-container {
  position: fixed;
  top: 80px;
  right: 24px;
  z-index: 10100;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  pointer-events: none;
}

.bb-toast {
  pointer-events: auto;
  min-width: 280px;
  max-width: 400px;
  padding: 14px 18px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 0.9rem;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  animation: bb-toast-in 200ms ease forwards;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.bb-toast--success {
  background: var(--bb-emerald-light);
  color: #047857;
  border: 1px solid var(--bb-emerald);
}

.bb-toast--error {
  background: var(--bb-red-light);
  color: #B91C1C;
  border: 1px solid var(--bb-red);
}

.bb-toast--info {
  background: var(--bb-sky-light);
  color: #0369A1;
  border: 1px solid var(--bb-sky);
}

@@keyframes bb-toast-in {
  from { opacity: 0; transform: translateX(24px); }
  to { opacity: 1; transform: translateX(0); }
}

/* Hide Gentelella alerts inside bb-page when toast is used */
.bb-page > .alert.alert-success,
.bb-page > .alert.alert-danger,
.bb-page > .alert.alert-warning,
.bb-page > .alert.alert-info {
  display: none;
}

/* ── Responsive ── */
@@media (max-width: 1279px) {
  .bb-kpi-row { grid-template-columns: repeat(2, 1fr); }
  .bb-row-2 { grid-template-columns: 1fr; }
  .bb-dispense-body { grid-template-columns: 1fr; }
  .bb-his-request-grid { grid-template-columns: 1fr; }
  .bb-his-request-item--primary,
  .bb-his-request-item--wide,
  .bb-his-request-id-strip { grid-column: 1; }
  .bb-dispense-destination-card__grid { grid-template-columns: 1fr; }
  .bb-dispense-destination-card__cell + .bb-dispense-destination-card__cell {
    border-left: none;
    border-top: 1px solid #ddd6fe;
  }
  .bb-dispense-panel { max-height: none; }
  .bb-bag-layout { grid-template-columns: 1fr; }
  .bb-audit-layout { grid-template-columns: 1fr; }
  .bb-donation-cards { grid-template-columns: 1fr; }
  .bb-form-grid-2 { grid-template-columns: 1fr; }
}

@@media (max-width: 640px) {
  .bb-kpi-row { grid-template-columns: 1fr; }
}

