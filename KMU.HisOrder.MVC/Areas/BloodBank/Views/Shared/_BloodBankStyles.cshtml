}
.bb-find-donor__card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.85rem;
  margin-bottom: 1rem;
}
.bb-find-donor__card-bt {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--bb-red-light);
  color: var(--bb-red);
  font-weight: 800;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bb-find-donor__card-name {
  display: block;
  font-size: 1.15rem;
}
.bb-find-donor__card-meta {
  margin: 0.2rem 0 0;
  font-size: 0.82rem;
  color: var(--bb-text-muted);
}
.bb-find-donor__card-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
  margin-bottom: 1rem;
  text-align: center;
}
.bb-find-donor__stat-n {
  display: block;
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1.1;
}
.bb-find-donor__stat-ok .bb-find-donor__stat-n { color: var(--bb-emerald); }
.bb-find-donor__stat-l {
  display: block;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--bb-text-muted);
}
.bb-find-donor__stat-d {
  display: block;
  font-size: 0.85rem;
  font-weight: 600;
  margin-top: 0.15rem;
}
.bb-find-donor__card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.bb-find-donor__list-title {
  margin: 0 0 0.65rem;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--bb-text-muted);
}
.bb-find-donor__matches {
  list-style: none;
  margin: 0;
  padding: 0;
}
.bb-find-donor__match {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 0.75rem 1rem;
  align-items: center;
  padding: 0.85rem 1rem;
  border: 1px solid var(--bb-border);
  border-radius: var(--bb-radius);
  margin-bottom: 0.5rem;
  text-decoration: none;
  color: inherit;
  transition: background 0.12s, border-color 0.12s;
}
.bb-find-donor__match:hover {
  background: var(--bb-slate-50);
  border-color: var(--bb-red);
}
.bb-find-donor__match-bt {
  font-weight: 800;
  font-size: 0.75rem;
  color: var(--bb-red);
  min-width: 2.5rem;
}
.bb-find-donor__match-body {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}
.bb-find-donor__match-body .bb-mono {
  font-size: 0.78rem;
  color: var(--bb-text-muted);
}
.bb-find-donor__match-stats {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--bb-emerald);
  white-space: nowrap;
}

@@media (max-width: 767px) {
  .bb-find-donor__card-stats { grid-template-columns: 1fr; }
  .bb-find-donor__match { grid-template-columns: 1fr; }
  .bb-find-donor__match-stats { grid-column: 1; }
}

/* ── Donor history & profile ── */
