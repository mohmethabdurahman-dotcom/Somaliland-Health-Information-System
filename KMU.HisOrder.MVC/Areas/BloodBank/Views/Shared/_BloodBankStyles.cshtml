.bb-dr-kpi--pending.is-active {
  border-color: #B45309;
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.35), 0 4px 14px rgba(180, 83, 9, 0.25);
}
/* Fulfilled — emerald / done */
.bb-dr-kpi--fulfilled {
  color: #065F46;
  background: linear-gradient(145deg, #ECFDF5 0%, #6EE7B7 100%);
  border-color: #10B981;
  box-shadow: 0 2px 10px rgba(16, 185, 129, 0.25);
}
.bb-dr-kpi--fulfilled .bb-dr-kpi__watermark { color: #059669; }
.bb-dr-kpi--fulfilled.is-active {
  border-color: #047857;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.35), 0 4px 14px rgba(4, 120, 87, 0.25);
}
/* Rejected — violet / declined (not red — reserved for Emergency) */
.bb-dr-kpi--rejected {
  color: #5B21B6;
  background: linear-gradient(145deg, #F5F3FF 0%, #C4B5FD 100%);
  border-color: #8B5CF6;
  box-shadow: 0 2px 10px rgba(139, 92, 246, 0.25);
}
.bb-dr-kpi--rejected .bb-dr-kpi__watermark { color: #7C3AED; }
.bb-dr-kpi--rejected.is-active {
