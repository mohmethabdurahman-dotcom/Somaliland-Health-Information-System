@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Blood Bank → Find Patient";
    var q = Context.Request.Query;
}
<partial name="~/Areas/BloodBank/Views/Shared/_BloodBankStyles.cshtml" />
<style>
    .bb-find-mrfind-content .direction {
        font-weight: bold;
        color: var(--bb-navy, #0B1F3A);
    }
    .bb-find-mrfind-content .direction:hover {
        text-decoration: underline;
    }
    .bb-find-mrfind-content .trHighlight {
        background-color: #FFFAD7 !important;
        border: inherit;
    }
</style>

<div class="bb-his-shell">
    <div class="bb-find-mrfind-content">
        @if (TempData["Error"] != null) { <div data-bb-toast data-bb-toast-type="error" class="bb-sr-only">@TempData["Error"]</div> }

        <h6 class="direction mx-2">@ViewData["Title"]</h6>
        <p class="small text-muted mx-2 mb-2">
            Search HIS patients. Use <i class="fa-solid fa-user-plus"></i> to register a directed donor or
            <i class="fa-solid fa-magnifying-glass"></i> to find a compatible donor.
        </p>
        <div class="form-group row mx-0 border-bottom">
            <div class="col-lg-9 border-right">
                <div class="form-group row mx-0 mb-0 align-self-end">
                    <label class="form-control col-lg-2 font-weight-bold border-0 px-0 pb-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;&nbsp;Patient ID Number:</label>
                    <label class="form-control col-lg-2 font-weight-bold border-0 px-0 pb-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;&nbsp;Mobile Phone:</label>
                    <label class="form-control col-lg-4 font-weight-bold border-0 px-0 pb-0 mb-0 align-self-end" style="background-color:inherit;font-size:12px">&nbsp;&nbsp;&nbsp;Patient Name:</label>
                </div>
                <div class="form-group row mx-0">
                    <input type="text" id="Txt_PatientID" class="form-control col-lg-2 font-weight-bold text-center rounded" value="@q["patientId"]" autocomplete="off" /> &nbsp;
                    <input type="text" id="Txt_MobilePhone" class="form-control col-lg-2 font-weight-bold text-center rounded" value="@q["phone"]" autocomplete="off" />&nbsp;
                    <input type="text" id="Txt_PatientName" class="form-control col-lg-4 font-weight-bold text-center rounded" value="@q["name"]" autocomplete="off" />&nbsp;
                    <button type="submit" class="btn btn-primary float-right" id="btnPatientSearch">Search</button>
                </div>
            </div>
            <div class="col-lg-3 d-flex align-items-end justify-content-end pb-1">
                <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Requests", new { area = "BloodBank" })'">Dr Requests</button>
            </div>
        </div>
        <div class="form-group row mx-0">
            <div class="col-12">
                <div id="PatientDataContent" class="collapse"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <partial name="~/Areas/BloodBank/Views/Shared/_BloodBankScripts.cshtml" />
    <partial name="~/Areas/BloodBank/Views/Patients/_FindPatientScripts.cshtml" />
}
