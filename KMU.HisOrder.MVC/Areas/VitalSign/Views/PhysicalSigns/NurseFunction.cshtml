        $("#ctriage").on("click", function () {
            const InhospID = $("#inhospID").val().trim();
            const triageLevel = $("#TriageNo").data("triage");
            const triageScore = $("#TriageScoreNo").val();

            const metrics = [
                { type: $(".Mobility").text(), value: $("#Mobility").val() },
                { type: $(".AVPU").text(), value: $("#AVPU").val() },
                { type: $(".Trauma").text(), value: $("#Trauma").val() },
                { type: $(".RR").text(), value: $("#RR").val() },
                { type: $(".Oxygen").text(), value: $("#Oxygen").val() },
                { type: $(".PhysicalHR").text(), value: $("#PhysicalHR").val() },
                { type: $(".SystolicBP").text(), value: $("#SystolicBP").val() },
                { type: $(".DiastolicBP").text(), value: $("#DiastolicBP").val() },
                { type: $(".Temperature").text(), value: $("#Temperature").val() },
                { type: $(".PhysicalRBS").text(), value: $("#PhysicalRBS").val() }
            ];

            const type = metrics.map(m => m.type);
            const value = metrics.map(m => m.value);

            if (!InhospID) {
                showError("This patient has no physical signs");
                return;
            }

            if (!triageLevel || !triageScore || metrics.some(m => !m.value.trim())) {
                showError("Please answer all physical signs of the patient!!");
                return;
            }

            $.ajax({
                type: "post",
                url: "/VitalSign/PhysicalSigns/savephs",
                data: { inhospID: InhospID, type, value },
                success: function () {
                    layer.msg('Created Successfully', { time: 2200, icon: 1 });
                    inputClear();
                },
                error: function (xhr) {
                    showError(xhr.responseJSON.responseText);
                }
            });

            $.ajax({
                type: "post",
                url: "/VitalSign/PhysicalSigns/savetriage",
                data: { id: InhospID, triageLevel: triageLevel, triageScore: triageScore },
                success: function () {
                    console.log('Triage saved successfully');
                },
                error: function (xhr) {
                    showError(xhr.responseJSON?.responseText || "Error saving triage data");
                }
            });
        });

