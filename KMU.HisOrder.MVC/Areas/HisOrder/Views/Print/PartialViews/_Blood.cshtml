@model KMU.HisOrder.MVC.Areas.HisOrder.ViewModels.PrintClass
@using KMU.HisOrder.MVC.Models

@{
    Model.FormTitle = "Blood (Dhiig)";
    List<Hisorderplan> IcdOrder = Model.OrderData.Where(c => c.HplanType == "ICD").ToList();
    List<Hisorderplan> LabOrder = Model.OrderData.Where(c => c.HplanType == "Blood").ToList();
    var Locations = ViewData["Locations"] as List<KmuCoderef>;
    List<string> GroupByOrderLocation = LabOrder.GroupBy(c => c.LocationCode).Select(g => g.Key).ToList();
}

<div id="BloodPage" class="page blood-print-page">
    <table class="PageContainerTable blood-print-table">
        <thead>
            <tr>
                <td class="PageFormTitleTd">
                </td>
            </tr>
            <tr>
                <td>
                    <div class="header-space"></div>
                </td>
            </tr>
        </thead>
        <tbody style="vertical-align: middle;">
            <tr>
                <td>
                    <div class="PageContent blood-print-content">
                        <h2 class="PageFormTitle">@Model.FormTitle</h2>
                        @if (IcdOrder.Count() > 0)
                        {
                            <h3 style="font-style:italic;">※ Diagnosis</h3>
                            @for (int i = 0; i < IcdOrder.Count(); i++)
                            {
                                <span style="margin-right: 21px; padding-right: 20px; font-size: 20px;">@(i + 1). @IcdOrder[i].PlanCode @IcdOrder[i].PlanDes</span>
                                <br />
                            }
                        }
                        <h3 style="font-style:italic;">※ Medical Category Item</h3>
                        <table id="LabDetailTable" class="DetailContentTable blood-print-detail">
                            <thead>
                                <tr style="text-decoration:underline;">
                                    <th></th>
                                    <th>ItemName</th>
                                    <th>Unit</th>
                                    <th>Code</th>
                                    <th>Blood Type</th>
                                    <th>Urgency</th>
                                    <th>Route</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (LabOrder.Count > 0)
                                {
                                    <tr><td colspan="8"><hr style="margin:0px;" /></td></tr>
                                    @for (int i = 0; i < GroupByOrderLocation.Count(); i++)
                                    {
                                        @for (int j = 0; j < LabOrder.Where(c => c.LocationCode == GroupByOrderLocation[i]).Count(); j++)
                                        {
                                            var item = LabOrder.Where(c => c.LocationCode == GroupByOrderLocation[i]).ToList()[j];
                                            var bloodType = !string.IsNullOrWhiteSpace(item.DosePath) ? item.DosePath.Trim() : "—";
                                            var urgency = item.UrgFlag switch
                                            {
                                                '3' => "Emergency",
                                                '2' => "Urgent",
                                                _ => "Routine"
                                            };
                                            <tr>
                                                <td style="width:20px; max-width:20px">@(j + 1).</td>
                                                <td style="width:250px; max-width:250px; white-space: normal;">@item.PlanDes</td>
                                                <td style="width:150px; max-width:150px; white-space: normal; word-wrap: break-word;">@item.QtyDose <b>Pack</b></td>
                                                <td style="width:150px; max-width:150px; white-space: normal; word-wrap: break-word;">@item.PlanCode</td>
                                                <td style="width:80px; max-width:80px; white-space: normal; font-weight:bold;">@bloodType</td>
                                                <td style="width:90px; max-width:90px; white-space: normal;">@urgency</td>
                                                <td>Route IV</td>
                                                <td style="width:150px; max-width:150px; white-space: normal; word-wrap: break-word;">@item.Remark</td>
                                            </tr>
                                        }
                                        if (!string.IsNullOrWhiteSpace(GroupByOrderLocation[i]))
                                        {
                                            <tr>
                                                <td colspan="8">
                                                    <h4>★ Location：@Locations.Where(c=>c.RefCode == GroupByOrderLocation[i]).Select(c=>c.RefName).FirstOrDefault()</h4>
                                                </td>
                                            </tr>
                                        }
                                        <tr><td colspan="8"><hr style="margin:0px;" /></td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    <div class="blood-print-footer">
        @Html.Partial("~/Areas/HisOrder/Views/Print/PartialViews/_v_Footer.cshtml",Model)
    </div>
</div>
