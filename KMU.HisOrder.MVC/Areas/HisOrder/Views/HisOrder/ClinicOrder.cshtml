@inject KMU.HisOrder.MVC.Models.KMUContext _context;
@using KMU.HisOrder.MVC.Areas.HisOrder.Models;
@using KMU.HisOrder.MVC.Areas.HisOrder.Controllers;
@using Microsoft.AspNetCore.Http;

@model PatientDTO

@{
    var Patientdto = ViewData["PatientDTO"];
    KMU.HisOrder.MVC.Areas.HisOrder.Models.PatientDTO _PatientDTO = (KMU.HisOrder.MVC.Areas.HisOrder.Models.PatientDTO)ViewData["PatientDTO"];

    var phys = _context.PhysicalSigns
        .Where(e => e.Inhospid == Model.Inhospid)
        .ToList();
    // Console.WriteLine(Model.Inhospid);
    // Console.WriteLine("phys count = " + phys.Count());
    var patientJson = System.Text.Json.JsonSerializer.Serialize(
        Model,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    );
    var physJson = System.Text.Json.JsonSerializer.Serialize(
        phys,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
    );
    var icdR = _context.KmuCoderefs.SingleOrDefault(c => c.RefCode == "ICDR").RefDefaultFlag;


    var visitStatus = "";
    var visitColor = "";
    //var showSaveBtn = true;
    var showExaminingBtn = true;
    switch (Model.RegStatus)
    {
        case "N":

            visitStatus = "Waiting";
            visitColor = "badge-outline-primary";
            break;
        case "T":
            visitStatus = "Examining";
            visitColor = "badge-outline-warning";
            break;
        case "*":
            //showSaveBtn = false;
            showExaminingBtn = false;
            visitStatus = "Completed";
            visitColor = "badge-outline-success";
            break;
    }


    List<Hisorderplan> MedList = ViewBag.MedList;
    List<Hisorderplan> NonMedList = ViewBag.NonMedList;
    List<hisordersoa_version> soapVersion = ViewBag.SoapVersion;
    List<HistoryRecordDto> HistoryRecordMaster = ViewBag.HistoryRecordMaster;


    var clinicDto = Context.Session.GetObject<ClinicDTO>("ClinicDTO");

    ViewData["SourceType"] = clinicDto.InhospType;
    ViewData["dptname"] = clinicDto.DeptCode;
    ViewData["MedFreq"] = ViewBag.MedFreq;
    ViewData["MedIndication"] = ViewBag.MedIndication;
    ViewData["MedPathWay"] = ViewBag.MedPathWay;
    ViewData["MedItem"] = ViewBag.MedItem;
    ViewData["PatientDTO"] = Model;
    ViewData["MG_INFO"] = ViewBag.MG_INFO;
    ViewData["NonMedLocation"] = ViewBag.NonMedLocation;




    ClinicDTO _clinicDto = null;
    if (Context.Session.GetObject<ClinicDTO>("ClinicDTO") != null)
    {
        _clinicDto = Context.Session.GetObject<ClinicDTO>("ClinicDTO");
    }

}


