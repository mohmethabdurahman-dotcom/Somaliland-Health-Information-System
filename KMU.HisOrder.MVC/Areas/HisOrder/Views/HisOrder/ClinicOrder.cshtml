<div class="modal fade" id="departmentModal" tabindex="-1" role="dialog" aria-labelledby="departmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header text-white ">
                <h5 class="modal-title" id="departmentModalLabel">
                    <i class="fa-solid fa-bed-pulse"></i> Select Department and Ward
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Department</label>
                    <select id="departmentSelect" class="form-control">
                        <option value="">Loading departments...</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Ward</label>
                    <select id="wardSelect" class="form-control" disabled>
                        <option value="">Please select department first</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    Close
                </button>
                <button type="button" id="saveDepartmentWard" class="btn btn-primary" disabled>
                    <i class="fas fa-calendar-check "></i> Save
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="dischargeModal" tabindex="-1" role="dialog" aria-labelledby="dischargeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="dischargeModalLabel">Discharge Status</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label for="dischargeStatus">Select Discharge Status:</label>
                    <select class="form-control" id="dischargeStatus" required>
                        <option value="" disabled selected>Select an option</option>
                        @foreach (var type in ViewBag.Discharge as List<KmuCoderef>)
                        {
                            <option value="@type.RefCode">@type.RefName</option>
                        }
                    </select>
                </div>

                <div class="form-group transfer-input" style="display: none;" id="transferInputDiv">
                    <label for="transefer_place">Transefer Place?</label>
                    <select class="form-control" id="transefer_place">
                        <option disabled selected>Select an option</option>
                        @foreach (var type in ViewBag.Departments as List<KmuDepartment>)
                        {
                            <option value="@type.DptCode">@type.DptName</option>
                        }
                    </select>
                    <input type="text" class="form-control" id="transfer_where" placeholder="Enter facility">
                </div>

                <button type="button" class="discharge-btn btn btn-success">Save</button>
            </div>

        </div>
    </div>
</div>
<!-- AI Generated Content Modal -->
<div class="modal fade" id="jsPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header justify-content-center position-relative">
                <h5 class="modal-title text-center w-100">
                    🤖 <span class="text-primary fw-bold">AI Generated Content</span>
                </h5>
                <button type="button" class="btn-close text-danger" data-dismiss="modal" aria-label="Close">
                    &times;
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <div class="row">
                    <!-- Combined Input Column -->
                    <div class="col-md-12" id="jsAiColumn">
                        <div id="jsPreviewRender" class="form-control" style="min-height: 400px; height: auto; white-space: pre-wrap; display:none;"></div>
                        <textarea id="jsPreviewTextarea" class="form-control" rows="15" style="display:none;"></textarea>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer d-flex flex-column align-items-center">
                <p class="helper-text mb-3 text-muted" id="jsModalHelperText">
                    Review the content below. Click a button to edit and save.
                </p>
                <div class="d-flex justify-content-center">
                    <button type="button" class="btn btn-secondary mx-2" id="jsDeclineBtn">
                        Manual
                    </button>
                    <button type="button" class="btn btn-primary mx-2" id="jsEditBtn">
                        AI
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>




@section scripts
{
    <script>
        var Root = '@Url.Content("~/HisOrder/")';
        var HISORDER_ROOT = Root = '@Url.Content("~/HisOrder/")';
        fullscreenLoading(true);
    </script>
    <script>
        // Inject the JSON you already prepared
        window.__patientDto    = @Html.Raw(patientJson);
        window.__physicalSigns = @Html.Raw(physJson);

        // Quick sanity‐check
        // console.log("➤ patientDto:", window.__patientDto);
        // console.log("➤ physicalSigns:", window.__physicalSigns);
    </script>
    @* <!-- Tagify -->
    <script src="~/lib/tagify/dist/jQuery.tagify.min.js"></script>
    <!--DragSort-->
    <script src="~/lib/dragsort/dragsort.js"></script>*@
    <!-- Ckeditor -->
    @*<script src="~/lib/ckeditor/ckeditor5-build-inline/build/ckeditor.js"></script>*@
    <!-- iCheck -->
    <script src="~/lib/iCheck/icheck.js"></script>
    <!-- CKeditor 4 -->
    <script src="~/lib/ckeditor4/ckeditor.js"></script>
    <!-- SignalR -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <!-- Area -->
    <script src="~/js/Area.js"></script>
    <!-- HisOrder InputHelper -->
    <script src="~/js/hisorderInputHelper.js"></script>
    <!-- HisOrder : clinicOrder -->
    <script src="~/js/clinicOrder.js"></script>
    <!-- HisOrder : soap -->
    <script src="~/js/soap.js"></script>
    <!-- HisOrder : medOrder -->
    <script src="~/js/medOrder.js"></script>
    <!-- History modal → SOAP / Medicine tab transfer -->
    <script src="~/js/history-transfer.js"></script>
    <!-- HisOrder : nonMedOrder -->
    <script src="~/js/nonMedOrder.js"></script>
    <!-- HisOrder : Diagnosis -->
    <script src="~/js/hisorderDiagnosisOrder.js"></script>



    <script type="text/javascript">
        $(document).ready(function () {
            $('#resultBtn').hide();

            $('#patientInhospid').val('@Model.Inhospid');
            $('#patientVisitStatus').val('@visitStatus');
            $('#patientHealthId').val('@Model.RegPatientId');
            $('#clinicSourceType').val('@clinicDto.InhospType');
            $('#wardid').val('@clinicDto.WardId');
            checkLabOrders('@Model.RegPatientId');

            //初始化各區塊js
            init_MedOrder();
            init_NonMedOrder();

            $('a[href="#Med_tab"]').on('shown.bs.tab', function (e) {
                fn_showMedOrderCount();
            })

            $('a[href="#NonMed_tab"]').on('shown.bs.tab', function (e) {
                fn_showNonMedOrderCount();
            })


            $('#dischargeStatus').on('change', function () {
                 var status = $(this).val();

          if (status === 'TW') {
            $('#transferInputDiv').show();
            $('#transefer_place').show();
            $('#transfer_where').hide();
          } else if (status === 'TF') {
            $('#transferInputDiv').show();
            $('#transefer_place').hide();
            $('#transfer_where').show();
          } else {
            $('#transferInputDiv').hide();
          }
            });

            $('.radio_transfer').iCheck({
                labelHover: true,
                cursor: true,
                checkboxClass: "icheckbox_flat-green",
                radioClass: "iradio_square-green",
                increaseArea: "15%"
            });

            $('.checkbox_transfer').iCheck({
                labelHover: true,
                cursor: true,
                checkboxClass: "icheckbox_flat-green",
                radioClass: "iradio_square-green",
                increaseArea: "15%"
            });

             $('#departmentModal').on('show.bs.modal', function () {
                 console.log("hhhhhhhhhhh");
                loadDepartments();
            });



            $('.checkbox_transfer').on('ifChanged', function (event) {

                const value = $(this).iCheck('update')[0].checked;
                if (value) {
                    $("#transfer_des").attr("readonly", false);
                } else {

                    layer.alert('Are you sure to cancel the transfer? Your description will be cleared together', {
                        skin: 'layui-layer-lan',
                        closebtn: 1,
                        anim: 5,
                        icon: 2,
                        btn: ['Yes', 'cancel'],
                        title: 'Edit Message',
                        yes: function (index) {
                            $('.checkbox_transfer').iCheck('uncheck');
                            $("#transfer_des").val("");
                            $("#transfer_des").attr("readonly", true);
                            layer.close(index);
                        },
                        btn2: function (index) {
                            $('.checkbox_transfer').iCheck('check');
                        }
                    });
                }
            });

            function checkLabOrders(patientId) {
                $.ajax({

                    url: '@Url.Action("CheckPatientLabs", "HisOrder")',
                    type: 'GET',
                    data: { patientId: patientId },
                    success: function (response) {
                        $('#loadingSpinner').hide(); // Hide the spinner once complete
                        if (response.hasLabOrders) {
                            $('#resultBtn').show();
                        } else {
                            $('#resultBtn').hide();
                        }
                    },
                    error: function () {
                        $('#loadingSpinner').hide();
                    }
                });
            };

            $('#historyrecord_btn').click(function () {

                var patientInhospid = $('#patientInhospid').val();
                var patientPatientid = $('#patientHealthId').val();
                var clinicSourceType = $('#clinicSourceType').val();
                console.log('clinicSourceType',clinicSourceType)
                var vURL = "/HisOrder/HisOrder/HistoryRecordMastrView";
                var vData = {
                    patientInhospid: patientInhospid,
                    patientPatientid: patientPatientid,
                    clinicSourceType: clinicSourceType,
                    showClinic: true,
                    showPrint: true
                };
                var vSuccessFunc = function (result) {
                    console.log(result);
                    if (result == "null") {
                        layer.alert('No historical medical records for this patient', {
                            skin: 'layui-layer-lan',
                            closebtn: 3,
                            anim: 5,
                            icon: 7,
                            btn: ['OK'],
                            title: 'Message',
                            OK: function (index) {
                                layer.close(index);
                            }
                        });
                    }
                    else {
                        $('#HisStroyRecordModal').empty();
                        $('#HisStroyRecordModal').html(result);
                        //事件重綁?

                        //default range
                        //$('input[.data-hs-date-from]').val()


                        $('#HisStroyRecordModal').find("input").iCheck({
                            labelHover: true,
                            cursor: true,
                            checkboxClass: "icheckbox_flat-green",
                            radioClass: "iradio_square-green",
                            increaseArea: "15%"
                        });

                        $('#v-pills-tab > button:first').tab('show') // Select first tab

                        $('#HisStroyRecordModal').modal('show');

                        $('#RePrintBtn').click(function () {

                            var activeLink = $('button.nav-link.active');
                            console.log('activeLink =' + activeLink);
                            var activeLinkInhospid = activeLink.data('inhospid');
                            console.log('activeLinkInhospid =' + activeLinkInhospid);
                            fn_RePrint(null, activeLinkInhospid);

                        });
                    }

                };
                var vErrorFunc = function () {
                    console.log("yyyyyyyyyyyyyyyyyy");
                    return this;
                };
                // History payload can be large; default ajaxGet timeout (10–20s) is often too low.
                ajaxGet(vURL, vData, vSuccessFunc, vErrorFunc, 120000);
            });

             function loadDepartments() {
                $.ajax({
                    url: '/HisOrder/HisOrder/GetDepartmentsWithWards',
                    type: 'GET',
                    beforeSend: function () {
                        $('#departmentSelect').empty().append('<option value="">Loading departments...</option>');
                    },
                    success: function (data) {
                        $('#departmentSelect').empty();
                        if (data.length > 0) {
                            $('#departmentSelect').append('<option value="">Select Department</option>');
                            $.each(data, function (index, department) {
                                $('#departmentSelect').append(`<option value="${department.id}">${department.name}</option>`);
                            });
                        } else {
                            $('#departmentSelect').append('<option value="">No departments available</option>');
                        }
                        resetWardDropdown();
                    },
                    error: function () {
                        $('#departmentSelect').empty().append('<option value="">Error loading departments</option>');
                        resetWardDropdown();
                    }
                });
            };

               $('#saveDepartmentWard').click(function () {
                const departmentCode = $('#departmentSelect').val();
                const wardId = $('#wardSelect').val();
                var patientInhospid = $('#patientInhospid').val();
                var patientPatientid = $('#patientHealthId').val();
                saveDepartmentWardSelection(departmentCode, wardId, patientPatientid,patientInhospid);
            });

            $('#departmentSelect').change(function () {
                const departmentCode = $(this).val();
                if (departmentCode) {
                    loadWards(departmentCode);
                } else {
                    resetWardDropdown();
                }
            });

            function loadWards(departmentCode) {
                $.ajax({
                    url: '/HisOrder/HisOrder/GetWardsByDepartment',
                    type: 'GET',
                    data: { departmentCode: departmentCode },
                    beforeSend: function () {
                        $('#wardSelect').empty().append('<option value="">Loading wards...</option>').prop('disabled', true);
                        $('#saveDepartmentWard').prop('disabled', true);
                    },
                    success: function (data) {
                        $('#wardSelect').empty().prop('disabled', false);
                        if (data.length > 0) {
                            $('#wardSelect').append('<option value="">Select Ward</option>');
                            $.each(data, function (index, ward) {
                                $('#wardSelect').append(`<option value="${ward.id}">${ward.name}</option>`);
                            });
                        } else {
                            $('#wardSelect').append('<option value="">No wards available for this department</option>');
                        }
                    },
                    error: function () {
                        $('#wardSelect').empty().append('<option value="">Error loading wards</option>').prop('disabled', true);
                        $('#saveDepartmentWard').prop('disabled', true);
                    }
                });
            }
                $('#wardSelect').change(function () {
                $('#saveDepartmentWard').prop('disabled', $(this).val() === '');
            });

            function resetWardDropdown() {
                $('#wardSelect').empty().append('<option value="">Select department first</option>').prop('disabled', true);
                $('#saveDepartmentWard').prop('disabled', true);
            }

            // Switch tabs according to menu button,and hide the other tab
            $('#MedicalCategoryList').on('show.bs.modal', function (e) {

                let btnId = $(e.relatedTarget).attr('id');
                switch (btnId) {
                    case "DiagnosisModalBtn":
                        $('#nav-ICD-tab').tab('show');
                        break;
                    case "MedModalBtn":
                        $('#nav-Med-tab').tab('show');
                        break;
                    case "NonMedModalBtn":
                        $('#nav-Lab-tab').tab('show');
                        break;
                }

                // Switch search input by menu button
                let MenuType = '';
                $(".MenuTabs").find('.nav-item .nav-link').each(function (index, value) {
                    if ($(this).hasClass('active') == true) {
                        let MenuSearch = $(this).data('search');
                        $('#SearchGroups .top_search').hide();
                        $('#' + MenuSearch).show();

                        // show the tab button
                        MenuType = $(this).parent().data('menutype');
                    }
                });

                $('#MedicalCategoryList .nav-item').each(function (index, value) {
                    if ($(this).data('menutype') == MenuType) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

              function saveDepartmentWardSelection(departmentCode, wardId,patientPatientid,inhospitalId) {
            $.ajax({
                url: '/HisOrder/HisOrder/SaveDepartmentWard',
                type: 'POST',
                data: {
                    departmentCode: departmentCode,
                    patientPatientid: patientPatientid,
                    departmentCode: departmentCode,
                    inhospitalId: inhospitalId,
                    wardId: wardId
                },
                success: function(response) {
                    console.log(response)
                    if(response.success==true){
                           const editorElement = $('#editor_managment');
                                        $('#MG_Inward').iCheck('check');

                           const department = response.departmentName || '[Department]';
        const ward = response.wardName || '[Ward]';

        const transferText = `<p> transferring to <strong>${department}</strong>  And <strong>${ward}</strong> .</p>`;


            if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances.editor_managment) {
                  layer.msg('Department/Ward saved successfully!', { icon: 1 });

                    $('#departmentModal').modal('hide');
                            $('#departmentModal').removeClass('show').hide();
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open');
                CKEDITOR.instances.editor_managment.setData(transferText);
                            layer.msg('Department/Ward saved successfully!', { icon: 1 });

            } else {
                  layer.msg('Department/Ward saved successfully!', { icon: 1 });

                    $('#departmentModal').modal('hide');
                            $('#departmentModal').removeClass('show').hide();
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open');

                editorElement.html(transferText);
            }
                        layer.msg('Department/Ward saved successfully!', { icon: 1 });

                    $('#departmentModal').modal('hide');

                    }
                         else{
        layer.alert(response.message, {
                                      skin: 'layui-layer-lan',
                                      closebtn: 1,
                                      anim: 5,
                                      icon: 2,
                                      btn: ['OK'],
                                      title: 'Error Message'
                                  }, function (index) {
                                      layer.close(index);
                                  });

                                                 $('#departmentModal').modal('hide');

                         }
                },
                error: function() {
                    $('#departmentModal').modal('hide');
                }
            });
        }
        });
        $(window).on('load', function () { fullscreenLoading(false); });

        $(window).resize(function () {
            CKEDITOR.instances.editor_clinic_remarks.resize("100%", $(".test1").height() - 68);
            CKEDITOR.instances.editor_managment.resize("100%", $(".test2").height() - 68);
        });

    </script>
}
