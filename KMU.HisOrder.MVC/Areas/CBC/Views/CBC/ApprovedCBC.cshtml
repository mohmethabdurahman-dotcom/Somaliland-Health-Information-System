@using KMU.HisOrder.MVC.Extesion;
@using KMU.HisOrder.MVC.Models;

@model List<KMU.HisOrder.MVC.Areas.CBC.ViewModel.TestLabsViewModel>

@{
    var allCount = Model.Count();
    var uCount = Model.Where(c => c.status == "UnApproved").Count();
    var aCount = Model.Where(c => c.status == "Approved").Count();
    
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Laboratory  → Approving Labs";
    var Title = ViewData["Title"] as string;
}
