<style>
    .searchCard {
        border: 1px solid black;
    }

    .infoCard {
        width: 73%;
        border-style: solid;
        border-width: 5px;
        border-color: black;
    }

    .tab-disabled {
        pointer-events: none;
        opacity: 0.6;
    }
    .input-box {
        display: flex;
        align-items: center;
        max-width: 300px;
        background: #fff;
        border: 1px solid #a0a0a0;
        border-radius: 4px;
        padding-left: 4px;
        overflow: hidden;
    }

        .input-box .prefix {
            font-weight: 300;
            font-size: 14px;
            color: #999;
            margin-right: 5px;
        }

        .input-box input {
            flex-grow: 1;
            background: #fff;
            border: none;
            outline: none;
            padding: 0px;
        }

    .disabledDiv {
        pointer-events: none;
        opacity: 0.4;
        filter: blur(1px);
    }

    .fw {
        font-size: 14px;
    }

    .kas {
        width: 100px;
    }

    #loading-spinner {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 9999;
    }

    .loading-indicator4 {
        display: none;
        position: fixed;
        top: 150px;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        right: 0;
        bottom: 0;
    }

    .loaderbody2 {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loader2 {
        border: 8px solid #f3f3f3; /* Light grey */
        border-top: 8px solid #ff4122; /* Purple */
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 2s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

