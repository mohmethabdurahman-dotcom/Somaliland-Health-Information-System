@model List<KMU.HisOrder.MVC.Areas.CBC.ViewModel.TestLabsViewModel>

<div class="col-xl-12">
    @foreach (var patient in Model)
    {
        <!-- Patient Details Section -->
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="mr-1 position-relative d-flex justify-content-end align-items-end mx-2">
                    <img src="~/images/avatar.png"
                     class="avatar-xl rounded-circle border-width-4 border-white"
                     alt=""
                     style="width: 66px; height:66px;" />
                </div>
                <div class="ml-2">
                    <div class="mt-2 d-block">
                        <h5 class="d-inline-block" id="patientName">
                            <strong>@patient.FirstName @patient.MidName @patient.LastName</strong>
                        </h5>
                        <div class="d-inline-block ml-2">
                            <label class="badge rounded-pill badge-danger" hidden>Waiting</label>
                            <label class="badge rounded-pill badge-warning"><i class="fa far fa-star"></i></label>
                        </div>
                    </div>

                    <div class="text-dark">
                        <h6 class="d-inline-block mr-3 pt-bl-color">
                            <a href="#" title="Patient ID">
                                <i class="fa-solid fa-id-card mr-2 text-primary"
                               data-toggle="tooltip"
                               data-placement="right"
                               data-original-title="patient id"></i>
                            </a>
                            <span id="patientID">@patient.PatientId</span>
                        </h6>
                        <h6 class="d-inline-block mr-3">
                            <a href="#" title="Birthday / Age">
                                <i class="fa-solid fa-b mr-2 text-primary"
                               data-toggle="tooltip"
                               data-placement="right"
                               data-original-title="birthday"></i>
                            </a>
                            <span id="birthdate">@patient.BirthDate?.ToShortDateString()</span>
                        </h6>
                        <h6 class="d-inline-block mr-3">
                            <a href="#" title="Sex">
                                <i class="fa-solid fas fa-venus-mars mr-2 text-primary"
                               data-toggle="tooltip"
                               data-placement="right"
                               data-original-title="sex"></i>
                            </a>
                            <span id="sex">@((patient.Gender=="M")?"Male":"Female")</span>
                        </h6>
                        <h6 class="d-inline-block mr-2">
                            <a href="#" title="Mobile">
                                <i class="fa fa-phone mr-2 text-primary"
                               data-toggle="tooltip"
                               data-placement="right"
                               data-original-title="mobile"></i>
                            </a>
                            <span id="phoneNumber">@patient.MobilePhone</span>
                        </h6>
                        <h6 class="d-inline-block mr-2 pt-br-color">
                            <a href="#" title="Address">
                                <i class="fa far fas fa-location-dot mr-2 text-primary"
                               data-toggle="tooltip"
                               data-placement="right"
                               data-original-title="address"></i>
                            </a>
                            <span id="address">@patient.Address</span>
                        </h6>
                    </div>
                </div>

            </div>

        </div>

        <!-- Lab Test Results Section -->
     

<div class="col-xl-12">
    <!-- All Results Except CBC -->
    

            <div class="card-body"
             style="font-size: 1rem; color: #2A3F54; background-color: whitesmoke; margin: 0px 25px 0px 25px; border-radius: 8px;">
                <table class="table table-sm  table-striped">
                    <thead>
                        <tr class="text-center text-white" style="font-size: 20px; background-color: #2A3F54;">
                            <th class="">ID</th>
                            <th class="">Test Name</th>
                            <th class="">Result</th>
                            <th class="">Unit</th>
                            <th class="">Normal Value</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        @if (patient.TestResults?.Any(t => t.TestName == "CBC") == true)
                        {
                            int rowNumber = 1; // Row counter
                            foreach (var test in patient.TestResults.Where(t => t.TestName == "CBC"))
                            {
                                var referenceRange = test.NvalueMale?.Split('-');
                                decimal minValue = 0, maxValue = 0;
                                var wbcSubTests = new[] { "LY", "MO", "EO", "BA", "NE", "GRAN" };
                                var isWbcSubset = wbcSubTests.Any(sub => test.Contents.Contains(sub));
                                if (referenceRange != null && referenceRange.Length == 2)
                                {
                                    minValue = Convert.ToDecimal(referenceRange[0].Trim());
                                    maxValue = Convert.ToDecimal(referenceRange[1].Trim());
                                }

                                decimal result = Convert.ToDecimal(test.Result);

                                bool isOutOfRange = result < minValue || result > maxValue;

                                string resultStyle = isOutOfRange ? "color: red;" : "";


                                <tr class="text-center" style="font-size: 0.85em">
                                    <td>@rowNumber</td>
                                    <td>@test.Contents</td>
                                    <td style="@resultStyle">

                                         @if (!isOutOfRange)
                                        {
                                        <span class="text-secondary text-bold"><i class="fa fa-check text-success result-icon"></i>@test.Result</span>
                                        }
                                        else
                                        {
                                        <span class="text-danger text-bold"><i class="fa fa-times text-danger result-icon"></i>@test.Result</span>
                                        }
                                    </td>
                                    <td>@test.Sufix</td>
                                    <td>@(patient.Gender == "M" ? test.NvalueMale : test.NvalueFemale)</td>
                                    
                                </tr>
                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center">No other test results available.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

        
        </div>

    }
</div>
