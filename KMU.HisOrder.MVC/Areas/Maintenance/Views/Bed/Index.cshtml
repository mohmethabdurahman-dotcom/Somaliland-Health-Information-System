@model IEnumerable<KMU.HisOrder.MVC.Models.BedviewModel>

@{
    var Title = ViewData["Title"] = "Maintain → Bed Management";
    Layout = "/Views/Shared/_Layout.cshtml";
    var allCount = Model.Count();
    var aCount = Model.Where(c => c.status == "Available").Count();
    var oCount = Model.Where(c => c.status == "Occupied").Count();
    var uCount = Model.Where(c => c.status == "Undermaintance").Count();

}
<link href="~/css/style.css" rel="stylesheet" />


<div class="card shadow mb-4 px-3 py-4">
    <div class="d-flex justify-content-between">
        <h2 class="direction" style="">@Title</h2>
        <a asp-action="create" class="btn btn-primary">Create New</a>
    </div>
    <div class="">
        <div class="row mb-3">
            <div class="col-lg-3 col-sm-6 pt-1 pb-0">
                <div class="card p-2">
                    <div class="stat-widget-one card-body">
                        <div class="stat-icon d-inline-block">
                            <i class="fa fa-shapes text-info border-info"></i>
                        </div>
                        <div class="stat-content d-inline-block">
                            <div class="stat-text">All Beds</div>
                            <div class="stat-digit"><strong>@allCount</strong></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 pt-1 pb-0">
                <div class="card p-2">
                    <div class="stat-widget-one card-body">
                        <div class="stat-icon d-inline-block">
                            <i class="fa-solid fa-bed text-primary border-primary"></i>
                        </div>
                        <div class="stat-content d-inline-block">
                            <div class="stat-text">Available Beds</div>
                            <div class="stat-digit"><strong>@aCount</strong></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 pt-1 pb-0">
                <div class="card p-2">
                    <div class="stat-widget-one card-body">
                        <div class="stat-icon d-inline-block">
                            <i class="fa-solid fa-bed-pulse text-danger border-danger"></i>
                        </div>
                        <div class="stat-content d-inline-block">
                            <div class="stat-text">Occupied Beds</div>
                            <div class="stat-digit"><strong>@oCount</strong></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 pt-1 pb-0">
                <div class="card p-2">
                    <div class="stat-widget-one card-body">
                        <div class="stat-icon d-inline-block">
                            <i class="fa-solid fa-bed text-success border-secondary"></i>
                        </div>
                        <div class="stat-content d-inline-block">
                            <div class="stat-text">Under Maintance Beds</div>
                            <div class="stat-digit"><strong>@uCount</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th>No</th>
                        <th>Bed Name</th>
                        <th>Ward</th> 
                        <th>Status </th>
                        <th>Create By</th>
                        <th>Create Time</th>

                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Select((value, index) => new { value, index }))
                    {
                        <tr>
                            <td>@(item.index + 1)</td> 
                            <td>@Html.DisplayFor(modelItem => item.value.bedName)</td>
                            <td>@Html.DisplayFor(modelItem => item.value.wardname)</td>
                            <td>@Html.DisplayFor(modelItem => item.value.status)</td>
                            <td>@Html.DisplayFor(modelItem => item.value.createBy)</td>
                            <td>@Html.DisplayFor(modelItem => item.value.createAt)</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.value.bedId" class="fa-solid fa-pencil fa-xl text-primary"></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            $(document).ready(function () {
                $('#dataTable').DataTable({
                    scrollX: false,
                    lengthMenu: [3],
                    searching: true,
                    info: false,
                    "pageLength": 10,
                    "ordering": true,
                    "responsive": true
                });
            });
        </script>
}